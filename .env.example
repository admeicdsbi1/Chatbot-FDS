# Copy to .env and fill in. .env is gitignored — never commit real keys.
#   cp .env.example .env
# Anything already set in the real environment wins over this file, so the
# Render dashboard stays authoritative in production (see backend/load_env.py).

# ── LLM / embeddings (backend runtime + ingestion) ───────────────────────────
# Google AI Studio. Used for answers, embeddings, the reranker and OCR.
# The embedding model is NOT swappable — embeddings.npy is tied to it — so this
# key is the one hard requirement for semantic retrieval.
GEMINI_API_KEY=
GEMINI_EMBED_DIM=768
# gemini-2.5-flash 404s for new API keys; thinkingBudget:0 is set in code
# (without it, responses come back empty).
GEMINI_MODEL=gemini-3.5-flash
GEMINI_OCR_MODEL=gemini-3.1-flash-lite
# Seconds between OCR calls; raise if you see 429s on a long ingest run.
GEMINI_OCR_SLEEP=3

# ── LLM fallback pools (each is a separate free per-model daily quota) ────────
# Chain: Gemini -> Groq-70b -> Groq-8b -> OpenRouter -> Cerebras.
GROQ_API_KEY=
OPENROUTER_API_KEY=
CEREBRAS_API_KEY=

# ── Reranker ─────────────────────────────────────────────────────────────────
# 1 to enable the flash-lite reranker (big precision win; runs on GEMINI_API_KEY)
RERANK_ENABLED=1

# ── Source-PDF hosting (Cloudflare R2, S3-compatible) ────────────────────────
# Public base URL of the bucket. BUILD-TIME ONLY: build_kb.py bakes the download
# links into chunks_merged.jsonl, so changing this needs a KB rebuild.
PDF_BUCKET_BASE=https://pub-1bc96d55fb9449beb82e81b5c88871c2.r2.dev
# Credentials for ingest/upload_pdfs.py only — the backend never needs these.
S3_ENDPOINT=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_BUCKET=maintenancebot
S3_REGION=auto

# ── Backend misc ─────────────────────────────────────────────────────────────
# Comma-separated allowed origins; empty/unset allows all (fine for local dev).
ALLOWED_ORIGINS=
