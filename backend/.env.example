# --- LLM (at least one required; Gemini is primary, Groq is fallback) ---
# Google AI Studio (free tier): https://aistudio.google.com/apikey
GEMINI_API_KEY=
# Groq (free tier): https://console.groq.com/keys  — also powers voice STT
GROQ_API_KEY=

# --- Optional overrides ---
# GEMINI_MODEL=gemini-2.5-flash
# GROQ_MODEL=llama-3.3-70b-versatile
# GROQ_STT_MODEL=whisper-large-v3-turbo
# GEMINI_EMBED_DIM=768   # must match the committed embeddings.npy
# TOP_K_FINAL=8
# CTX_CHUNK_CHARS=2500
# LLM_MAX_TOKENS=1500

# --- Optional nicer Hindi TTS (else gTTS is used) ---
# SARVAM_API_KEY=

# --- CORS: set to your Vercel URL in production, e.g. https://your-app.vercel.app ---
ALLOWED_ORIGINS=*
